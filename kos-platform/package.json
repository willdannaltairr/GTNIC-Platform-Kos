{
  "name": "kos-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Living & Trust-Based Boarding House Platform — monorepo",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "db:generate": "npx prisma generate --schema packages/shared/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema packages/shared/prisma/schema.prisma",
    "db:seed": "npx ts-node --compiler-options {\"module\":\"commonjs\"} packages/shared/seed.ts",
    "build:web": "npm run build --prefix apps/web",
    "build:api": "npx tsc --noEmit --project apps/api/tsconfig.json"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "devDependencies": {
    "typescript": "^5",
    "ts-node": "^10",
    "prisma": "^5"
  }
}
