# Port server API
PORT=4000

# Koneksi PostgreSQL. Bawaannya cluster dev lokal (lihat `npm run db:local`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/kos_platform

# Jumlah koneksi maksimum di pool. Cluster lokal tidak membatasi, hosting gratis biasanya 20.
DB_POOL_MAX=10

# Kunci tanda tangan token sesi. Wajib, minimal 32 karakter acak.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Umur token akses dan token penyegar sesi.
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# Origin frontend yang boleh memanggil API, dipisah koma.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Alamat publik backend, dipakai menyusun URL foto dan tautan berkas privat.
# Di produksi isi dengan alamat server yang sebenarnya, tanpa garis miring di akhir.
API_BASE_URL=http://localhost:4000

# Folder penyimpanan unggahan, relatif terhadap folder kerja backend.
UPLOAD_DIR=uploads

# Kunci tanda tangan tautan berkas privat. Bila kosong, JWT_SECRET yang dipakai.
FILE_SIGNING_SECRET=

# Email (opsional). Tanpa kunci, tautan verifikasi dan atur ulang sandi ditulis ke log.
RESEND_API_KEY=

# Midtrans (opsional). Tanpa kunci server, tautan pembayaran belum bisa dibuat.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Jalur uji yang hanya boleh hidup di pengembangan. Jangan dinyalakan di produksi.
MODE_PENGEMBANGAN=false
TOKEN_PENGEMBANGAN=false
