// MODULE 13: ADDITIONAL TABLES
// ════════════════════════════════════════════════════════════════════════════

model expenses {
  id          String    @id @default(uuid()) @db.Uuid
  property_id String    @db.Uuid
  category    String
  amount      Decimal   @db.Decimal(14, 2)
  description String?
  date        DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  property properties @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model password_reset_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @unique @db.Uuid
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(3)
  used_at    DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model refresh_sessions {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(3)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model content_articles {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  slug         String    @unique
  content      String?
  author_id    String?   @db.Uuid
  status       String    @default("draft")
  published_at DateTime? @db.Timestamptz(3)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @updatedAt @db.Timestamptz(3)

  author users? @relation(fields: [author_id], references: [id])

  @@map("content_articles")
}
