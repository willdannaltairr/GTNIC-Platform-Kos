# ════════════════════════════════════════════════════════════════════════════
# KosPlatform — referensi environment variable
#
# Salin berkas ini menjadi backend/.env (dan frontend/.env.local untuk bagian
# frontend), lalu isi nilainya. Jangan pernah commit berkas .env asli.
# ════════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL / Supabase) ───────────────────────────────────────
# Ambil dari dashboard Supabase: Connect → Session pooler.
#
# PENTING — pakai Session pooler, bukan koneksi langsung:
#   Host langsung (db.<ref>.supabase.co:5432) hanya punya alamat IPv6. Dari
#   jaringan yang cuma punya IPv4, host itu tidak bisa dihubungi sama sekali,
#   dan gejalanya menyesatkan: errornya "ENOTFOUND" seolah DNS rusak.
#   Session pooler (aws-<n>-<region>.pooler.supabase.com:5432) selalu IPv4.
#
# Jangan menambahkan ?sslmode=require ke string ini. Bila parameter itu ada,
# driver pg mengabaikan pengaturan TLS dari aplikasi dan memakai pengaturannya
# sendiri — muncul "self-signed certificate in certificate chain". Enkripsi
# sudah diurus otomatis oleh backend/src/lib/db.ts.
#
# Mengembangkan tanpa internet? Cluster PostgreSQL lokal bisa dipakai:
#   npm run db:local -- init
#   DATABASE_URL="postgresql://postgres@127.0.0.1:5433/kos_platform"
DATABASE_URL="postgresql://postgres.ftunxbdpiokslgrzcmvd:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Mode TLS ke database: auto | disable | require
#   auto    → TLS menyala untuk host non-lokal, mati untuk localhost (default)
#   require → paksa terenkripsi
# Kosongkan atau tulis "auto" bila tidak yakin.
DB_SSL="auto"

# ─── Aplikasi ───────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
API_PREFIX="/api/v1"

# ─── Frontend (dipakai browser untuk memanggil API) ─────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Autentikasi (JWT) ──────────────────────────────────────────────────────
# WAJIB diganti sebelum dipakai di luar mesin lokal.
JWT_SECRET="change-this-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Hash password ──────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── Midtrans (sandbox, untuk pengembangan/demo) ────────────────────────────
# Belum dipakai kode; disiapkan untuk fase pembayaran.
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# ─── Google Maps Platform ───────────────────────────────────────────────────
# Belum dipakai kode; disiapkan untuk fase peta dan rute.
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ─── Cloudinary (penyimpanan gambar) ────────────────────────────────────────
# Belum dipakai kode.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Belum dipakai kode.
RESEND_API_KEY="your-resend-api-key"

# ─── Pemantauan (Sentry) ────────────────────────────────────────────────────
# Belum dipakai kode.
SENTRY_DSN="your-sentry-dsn"
