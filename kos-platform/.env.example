# ---------------------------------------------------------------------------
# Nestari environment template. Copy to apps/api/.env and apps/web/.env.local.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api/v1

# Database (portable local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/nestari?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55432/nestari?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/nestari_test?schema=public

# Session / crypto
SESSION_COOKIE_NAME=nestari_session
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Supabase (optional deployment path; not used by local auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nestari-public
SUPABASE_PRIVATE_BUCKET=nestari-private

# Storage: local | supabase | cloudinary
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
MAX_UPLOAD_MB=5

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans (sandbox unless explicitly production)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
ALLOW_PAYMENT_SIMULATION=true

# Google Maps (optional; server key must never be exposed to the browser)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email: console | resend
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@nestari.local

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Seed demo password (development only)
SEED_PASSWORD=Nestari123!
