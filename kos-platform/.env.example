# Database (PostgreSQL + PostGIS via Prisma)
# Dev lokal proyek ini memakai cluster terpisah di port 5433
# (dibuat sekali dengan: npm run db:local -- init).
# Untuk Neon/Supabase/layanan lain, ganti dengan connection string masing-masing.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/kos_platform?schema=public"
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/kos_platform?schema=public"

# Application
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
API_PREFIX="/api/v1"

# Authentication (JWT)
JWT_SECRET="change-this-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Midtrans (sandbox for development/demo)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# Google Maps Platform
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"

# Monitoring (Sentry)
SENTRY_DSN="your-sentry-dsn"
