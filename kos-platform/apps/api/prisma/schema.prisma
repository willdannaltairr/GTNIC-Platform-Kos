// Nestari database schema.
// PostgreSQL is the source of truth. Prisma Migrate is the only schema tool for
// application tables. Money is always NUMERIC, never float. Financial history is
// never cascaded away.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  TENANT
  OWNER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION

  @@map("account_status")
}

enum OwnerVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED

  @@map("owner_verification_status")
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_verification_status")
}

enum DocumentType {
  IDENTITY_CARD
  SELFIE
  BUSINESS_PERMIT
  PROPERTY_DEED
  CONTRACT
  OTHER

  @@map("document_type")
}

enum PropertyType {
  KOS_PUTRA
  KOS_PUTRI
  KOS_CAMPUR

  @@map("property_type")
}

enum GenderPolicy {
  MALE_ONLY
  FEMALE_ONLY
  MIXED

  @@map("gender_policy")
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@map("publication_status")
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  STUDIO
  SHARED

  @@map("room_type")
}

enum BathroomType {
  INSIDE
  OUTSIDE

  @@map("bathroom_type")
}

enum RoomAvailabilityStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  INACTIVE

  @@map("room_availability_status")
}

enum FacilityCategory {
  GENERAL
  ROOM
  SECURITY
  PARKING
  UTILITY
  KITCHEN
  OTHER

  @@map("facility_category")
}

enum BillingType {
  FIXED
  VARIABLE
  ONE_TIME
  MONTHLY

  @@map("billing_type")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("booking_status")
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  TERMINATED
  CANCELLED

  @@map("contract_status")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

enum InvoiceItemCostType {
  RENT
  DEPOSIT
  UTILITY
  SERVICE
  PENALTY
  OTHER

  @@map("invoice_item_cost_type")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentProvider {
  MIDTRANS
  MANUAL
  SIMULATED

  @@map("payment_provider")
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED

  @@map("webhook_processing_status")
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  FURNITURE
  CLEANING
  INTERNET
  SECURITY
  OTHER

  @@map("maintenance_category")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("maintenance_priority")
}

enum MaintenanceStatus {
  OPEN
  REVIEWING
  IN_PROGRESS
  WAITING_FOR_PARTS
  RESOLVED
  REJECTED
  CLOSED

  @@map("maintenance_status")
}

enum RoomConditionReportType {
  CHECK_IN
  PERIODIC_INSPECTION
  CHECK_OUT

  @@map("room_condition_report_type")
}

enum ConditionStatus {
  GOOD
  FAIR
  DAMAGED
  NOT_APPLICABLE

  @@map("condition_status")
}

enum ConditionReportStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  DISPUTED
  COMPLETED

  @@map("condition_report_status")
}

enum AcknowledgementType {
  APPROVED
  DISPUTED

  @@map("acknowledgement_type")
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("visit_status")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED

  @@map("review_status")
}

enum ReportTargetType {
  USER
  PROPERTY
  BOOKING
  PAYMENT
  OTHER

  @@map("report_target_type")
}

enum ReportCategory {
  INCORRECT_INFORMATION
  PRICE_TRANSPARENCY
  UNAVAILABLE_PROPERTY
  FRAUD_SUSPICION
  INAPPROPRIATE_BEHAVIOR
  PAYMENT_ISSUE
  SERVICE_ISSUE
  OTHER

  @@map("report_category")
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED

  @@map("report_status")
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  INVOICE_CREATED
  INVOICE_DUE_SOON
  MAINTENANCE_CREATED
  MAINTENANCE_UPDATED
  CONTRACT_CREATED
  CONTRACT_EXPIRING
  ROOM_AVAILABILITY_REMINDER
  PROPERTY_VERIFIED
  PROPERTY_REJECTED
  OWNER_VERIFICATION_SUBMITTED
  REPORT_CREATED
  SYSTEM

  @@map("notification_type")
}

enum ExpenseCategory {
  MAINTENANCE
  ELECTRICITY
  WATER
  INTERNET
  CLEANING
  TAX
  OTHER

  @@map("expense_category")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

enum VerificationDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
  SUSPENDED

  @@map("verification_decision")
}

enum DestinationCategory {
  CAMPUS
  OFFICE
  STATION
  TERMINAL
  LANDMARK
  OTHER

  @@map("destination_category")
}

enum NearbyCategory {
  MINIMARKET
  HOSPITAL
  CLINIC
  PHARMACY
  RESTAURANT
  WORSHIP
  ATM
  BUS_STOP
  STATION
  CAMPUS
  OTHER

  @@map("nearby_category")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  fullName        String        @map("full_name") @db.VarChar(150)
  phoneNumber     String?       @map("phone_number") @db.VarChar(30)
  avatarUrl       String?       @map("avatar_url") @db.Text
  role            UserRole      @default(TENANT)
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  ownerProfile                OwnerProfile?
  tenantProfile               TenantProfile?
  sessions                    Session[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  properties                  Property[]                     @relation("PropertyOwner")
  tenantBookings              Booking[]                      @relation("BookingTenant")
  ownerBookings               Booking[]                      @relation("BookingOwner")
  contractsAsTenant           Contract[]                     @relation("ContractTenant")
  contractsAsOwner            Contract[]                     @relation("ContractOwner")
  invoicesAsTenant            Invoice[]                      @relation("InvoiceTenant")
  invoicesAsOwner             Invoice[]                      @relation("InvoiceOwner")
  payments                    Payment[]
  maintenanceReported         MaintenanceRequest[]           @relation("MaintenanceReporter")
  maintenanceOwned            MaintenanceRequest[]           @relation("MaintenanceOwner")
  maintenanceAssigned         MaintenanceRequest[]           @relation("MaintenanceAssignee")
  conditionReportsAsTenant    RoomConditionReport[]          @relation("ConditionTenant")
  conditionReportsAsOwner     RoomConditionReport[]          @relation("ConditionOwner")
  conditionAcknowledgements   RoomConditionAcknowledgement[]
  conditionImagesUploaded     RoomConditionImage[]           @relation("ConditionImageUploader")
  maintenanceImagesUploaded   MaintenanceImage[]             @relation("MaintenanceImageUploader")
  favorites                   Favorite[]
  preference                  UserPreference?
  visits                      Visit[]
  reviews                     Review[]
  reportsFiled                Report[]                       @relation("ReportReporter")
  reportsReviewed             Report[]                       @relation("ReportReviewer")
  verificationDocuments       OwnerVerificationDocument[]    @relation("OwnerVerificationSubmitted")
  verificationReviews         OwnerVerificationDocument[]    @relation("OwnerVerificationReviewer")
  propertyVerificationActions PropertyVerificationHistory[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  propertyExpenses            PropertyExpense[]
  articles                    Article[]
  contractDocumentsUploaded   ContractDocument[]             @relation("ContractDocumentUploader")
  bookingStatusChanges        BookingStatusHistory[]         @relation("BookingStatusChanger")
  maintenanceStatusChanges    MaintenanceStatusHistory[]     @relation("MaintenanceStatusChanger")
  platformSettingsUpdated     PlatformSetting[]              @relation("PlatformSettingUpdater")
  propertyViews               PropertyView[]

  @@index([role])
  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model OwnerProfile {
  id                         String                  @id @default(uuid()) @db.Uuid
  userId                     String                  @unique @map("user_id") @db.Uuid
  businessName               String?                 @map("business_name") @db.VarChar(150)
  description                String?                 @db.Text
  identityVerificationStatus OwnerVerificationStatus @default(NOT_SUBMITTED) @map("identity_verification_status")
  verifiedAt                 DateTime?               @map("verified_at") @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_profiles")
}

model TenantProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  occupation            String?  @db.VarChar(100)
  institutionName       String?  @map("institution_name") @db.VarChar(150)
  emergencyContactName  String?  @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?  @map("emergency_contact_phone") @db.VarChar(30)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model OwnerVerificationDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  ownerId            String                     @map("owner_id") @db.Uuid
  documentType       DocumentType               @map("document_type")
  storagePath        String                     @map("storage_path") @db.Text
  fileName           String                     @map("file_name") @db.VarChar(255)
  mimeType           String                     @map("mime_type") @db.VarChar(100)
  sizeBytes          Int                        @map("size_bytes")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  reviewedById       String?                    @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason    String?                    @map("rejection_reason") @db.Text
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner      User  @relation("OwnerVerificationSubmitted", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("OwnerVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([ownerId, verificationStatus])
  @@index([reviewedById])
  @@map("owner_verification_documents")
}

// ---------------------------------------------------------------------------
// Property supply
// ---------------------------------------------------------------------------

model Property {
  id                             String             @id @default(uuid()) @db.Uuid
  ownerId                        String             @map("owner_id") @db.Uuid
  name                           String             @db.VarChar(180)
  slug                           String             @unique @db.VarChar(200)
  description                    String             @db.Text
  address                        String             @db.Text
  province                       String             @db.VarChar(100)
  city                           String             @db.VarChar(100)
  district                       String             @db.VarChar(100)
  subdistrict                    String?            @db.VarChar(100)
  postalCode                     String?            @map("postal_code") @db.VarChar(10)
  latitude                       Decimal            @db.Decimal(10, 7)
  longitude                      Decimal            @db.Decimal(10, 7)
  propertyType                   PropertyType       @map("property_type")
  genderPolicy                   GenderPolicy       @map("gender_policy")
  totalRooms                     Int                @default(0) @map("total_rooms")
  verificationStatus             VerificationStatus @default(PENDING) @map("verification_status")
  publicationStatus              PublicationStatus  @default(DRAFT) @map("publication_status")
  lastAvailabilityConfirmationAt DateTime?          @map("last_availability_confirmation_at") @db.Timestamptz(6)
  publishedAt                    DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt                      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  owner                 User                          @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  images                PropertyImage[]
  rooms                 Room[]
  facilities            PropertyFacility[]
  rules                 PropertyRule[]
  costComponents        CostComponent[]
  bookings              Booking[]
  contracts             Contract[]
  maintenanceRequests   MaintenanceRequest[]
  visits                Visit[]
  favorites             Favorite[]
  reviews               Review[]
  views                 PropertyView[]
  nearbyPlaces          NearbyPlace[]
  expenses              PropertyExpense[]
  verificationHistories PropertyVerificationHistory[]
  invoices              Invoice[]
  roomConditionReports  RoomConditionReport[]

  @@index([ownerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_city_trgm_idx")
  @@index([district(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_district_trgm_idx")
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_address_trgm_idx")
  @@index([city], map: "properties_city_idx")
  @@index([district], map: "properties_district_idx")
  @@index([verificationStatus])
  @@index([publicationStatus])
  @@index([latitude, longitude])
  @@index([publicationStatus, verificationStatus, city])
  @@map("properties")
}

model PropertyImage {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  storagePath  String   @map("storage_path") @db.Text
  altText      String?  @map("alt_text") @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, displayOrder])
  @@map("property_images")
}

model Room {
  id                          String                 @id @default(uuid()) @db.Uuid
  propertyId                  String                 @map("property_id") @db.Uuid
  roomNumber                  String                 @map("room_number") @db.VarChar(30)
  roomName                    String?                @map("room_name") @db.VarChar(120)
  description                 String?                @db.Text
  roomType                    RoomType               @map("room_type")
  areaWidth                   Decimal?               @map("area_width") @db.Decimal(5, 2)
  areaLength                  Decimal?               @map("area_length") @db.Decimal(5, 2)
  monthlyPrice                Decimal                @map("monthly_price") @db.Decimal(14, 2)
  maximumOccupants            Int                    @default(1) @map("maximum_occupants")
  bathroomType                BathroomType           @map("bathroom_type")
  floorNumber                 Int?                   @map("floor_number")
  availabilityStatus          RoomAvailabilityStatus @default(AVAILABLE) @map("availability_status")
  lastAvailabilityConfirmedAt DateTime?              @map("last_availability_confirmed_at") @db.Timestamptz(6)
  createdAt                   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime?              @map("deleted_at") @db.Timestamptz(6)

  property            Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images              RoomImage[]
  facilities          RoomFacility[]
  bookings            Booking[]
  contracts           Contract[]
  maintenanceRequests MaintenanceRequest[]
  conditionReports    RoomConditionReport[]
  costComponents      CostComponent[]
  visits              Visit[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, availabilityStatus])
  @@index([monthlyPrice])
  @@index([lastAvailabilityConfirmedAt])
  @@map("rooms")
}

model RoomImage {
  id           String   @id @default(uuid()) @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  storagePath  String   @map("storage_path") @db.Text
  altText      String?  @map("alt_text") @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, displayOrder])
  @@map("room_images")
}

model Facility {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique @db.VarChar(100)
  slug      String           @unique @db.VarChar(120)
  category  FacilityCategory @default(GENERAL)
  icon      String?          @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  propertyLinks PropertyFacility[]
  roomLinks     RoomFacility[]
  preferences   UserPreferenceFacility[]

  @@index([category])
  @@map("facilities")
}

model PropertyFacility {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  facilityId String @map("facility_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, facilityId])
  @@index([facilityId])
  @@map("property_facilities")
}

model RoomFacility {
  id         String @id @default(uuid()) @db.Uuid
  roomId     String @map("room_id") @db.Uuid
  facilityId String @map("facility_id") @db.Uuid

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([roomId, facilityId])
  @@index([facilityId])
  @@map("room_facilities")
}

model PropertyRule {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  isMandatory Boolean  @default(true) @map("is_mandatory")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_rules")
}

model CostComponent {
  id           String      @id @default(uuid()) @db.Uuid
  propertyId   String      @map("property_id") @db.Uuid
  roomId       String?     @map("room_id") @db.Uuid
  name         String      @db.VarChar(120)
  amount       Decimal     @db.Decimal(14, 2)
  billingType  BillingType @map("billing_type")
  isMandatory  Boolean     @default(true) @map("is_mandatory")
  isRefundable Boolean     @default(false) @map("is_refundable")
  isEstimated  Boolean     @default(false) @map("is_estimated")
  isConfirmed  Boolean     @default(true) @map("is_confirmed")
  description  String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([roomId])
  @@map("cost_components")
}

model Destination {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(150)
  category  DestinationCategory
  address   String?             @db.Text
  city      String              @db.VarChar(100)
  latitude  Decimal             @db.Decimal(10, 7)
  longitude Decimal             @db.Decimal(10, 7)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  preferences UserPreference[]

  @@index([city])
  @@map("destinations")
}

model NearbyPlace {
  id             String         @id @default(uuid()) @db.Uuid
  propertyId     String         @map("property_id") @db.Uuid
  name           String         @db.VarChar(150)
  category       NearbyCategory
  address        String?        @db.Text
  distanceMeters Int?           @map("distance_meters")
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  source         String         @default("SEED") @db.VarChar(20)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

