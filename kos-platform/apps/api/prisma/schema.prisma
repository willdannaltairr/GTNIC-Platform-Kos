model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  ownerId                String        @map("owner_id") @db.Uuid
  propertyId             String        @map("property_id") @db.Uuid
  roomId                 String        @map("room_id") @db.Uuid
  bookingCode            String        @unique @map("booking_code") @db.VarChar(40)
  startDate              DateTime      @map("start_date") @db.Date
  endDate                DateTime      @map("end_date") @db.Date
  monthlyPriceSnapshot   Decimal       @map("monthly_price_snapshot") @db.Decimal(14, 2)
  depositAmountSnapshot  Decimal       @default(0) @map("deposit_amount_snapshot") @db.Decimal(14, 2)
  additionalCostSnapshot Decimal       @default(0) @map("additional_cost_snapshot") @db.Decimal(14, 2)
  totalAmount            Decimal       @map("total_amount") @db.Decimal(14, 2)
  status                 BookingStatus @default(PENDING)
  tenantNotes            String?       @map("tenant_notes") @db.Text
  ownerNotes             String?       @map("owner_notes") @db.Text
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    User                   @relation("BookingTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  owner     User                   @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  property  Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room      Room                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  histories BookingStatusHistory[]
  contract  Contract?
  invoices  Invoice[]
  review    Review?

  @@index([tenantId, status])
  @@index([ownerId, status])
  @@index([roomId, startDate, endDate])
  @@index([status, expiresAt])
  @@map("bookings")
}

