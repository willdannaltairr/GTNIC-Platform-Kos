  @@map("room_condition_checklist_items")
}

model RoomConditionAcknowledgement {
  id                  String              @id @default(uuid()) @db.Uuid
  reportId            String              @map("report_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  acknowledgementType AcknowledgementType @map("acknowledgement_type")
  notes               String?             @db.Text
  acknowledgedAt      DateTime            @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  report RoomConditionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
  @@map("room_condition_acknowledgements")
}

// ---------------------------------------------------------------------------
// Governance, notifications, content
// ---------------------------------------------------------------------------

model PropertyVerificationHistory {
  id             String               @id @default(uuid()) @db.Uuid
  propertyId     String               @map("property_id") @db.Uuid
  adminId        String               @map("admin_id") @db.Uuid
  previousStatus VerificationStatus?  @map("previous_status")
  newStatus      VerificationStatus   @map("new_status")
  decision       VerificationDecision @map("decision")
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  admin    User     @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
  @@index([adminId])
  @@map("property_verification_histories")
}

model Report {
  id                  String           @id @default(uuid()) @db.Uuid
  reporterId          String           @map("reporter_id") @db.Uuid
  targetType          ReportTargetType @map("target_type")
  targetId            String?          @map("target_id") @db.Uuid
  category            ReportCategory
  description         String           @db.Text
  evidenceStoragePath String?          @map("evidence_storage_path") @db.Text
  status              ReportStatus     @default(OPEN)
  reviewedById        String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  resolutionNotes     String?          @map("resolution_notes") @db.Text
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              NotificationType
  title             String           @db.VarChar(180)
  message           String           @db.Text
  relatedEntityType String?          @map("related_entity_type") @db.VarChar(60)
  relatedEntityId   String?          @map("related_entity_id") @db.VarChar(80)
  isRead            Boolean          @default(false) @map("is_read")
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  emailEnabled             Boolean  @default(true) @map("email_enabled")
  pushEnabled              Boolean  @default(false) @map("push_enabled")
  bookingNotifications     Boolean  @default(true) @map("booking_notifications")
  paymentNotifications     Boolean  @default(true) @map("payment_notifications")
  maintenanceNotifications Boolean  @default(true) @map("maintenance_notifications")
  marketingNotifications   Boolean  @default(false) @map("marketing_notifications")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Article {
  id             String        @id @default(uuid()) @db.Uuid
  authorId       String        @map("author_id") @db.Uuid
  title          String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(220)
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImagePath String?       @map("cover_image_path") @db.Text
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@map("articles")
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.Text
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}
